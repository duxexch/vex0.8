{
  "entities": {
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Payment method and transfer instructions for user deposits and unfreeze flows",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "accountNumber": { "type": "string" },
        "holderName": { "type": "string" },
        "instructions": { "type": "string" },
        "instructionsAr": { "type": "string" },
        "instructionsEn": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "badge": { "type": "string" },
        "is_active": { "type": "boolean" },
        "minDeposit": { "type": "number" },
        "maxDeposit": { "type": "number" },
        "currency": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "name", "instructions", "is_active"]
    },
    "UserSubscription": {
      "title": "UserSubscription",
      "description": "User preferences and subscribed sports leagues for real-time match alerts and notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subscribedLeagues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "smartAlertLeagues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notificationTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "subscribedLeagues"]
    }
  },
  "firestore": {
    "/payment_methods/{methodId}": {
      "schema": "PaymentMethod",
      "description": "Publicly readable payment methods configured by administrators for deposit and balance unfreeze"
    },
    "/UserSubscriptions/{userId}": {
      "schema": "UserSubscription",
      "description": "User subscriptions and alert preferences for sports leagues and real-time matches"
    }
  }
}
